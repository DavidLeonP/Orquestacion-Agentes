# Copia este archivo a .env y completa los valores

# --- Model registry (perfiles de recurso) ---
# cloud_openai | vllm_usfq | local_barato | local_calidad
LLM_PROFILE=cloud_openai

# Overrides opcionales (si se definen, pisan el perfil)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# vLLM USFQ (requiere VPN; endpoints OpenAI-compatible solo HTTP)
# LLM_PROFILE=vllm_usfq
# LLM_BASE_URL=http://172.28.230.10:12555/v1
# EMBEDDING_BASE_URL=http://172.28.230.10:12556/v1
# OPENAI_COMPAT_API_KEY=local
# Modelos por defecto: deepseek-ai/DeepSeek-V4-Flash-0731 + BAAI/bge-m3
# Verifica los IDs reales con: python scripts/smoke_vllm_usfq.py

# Ollama local (perfil local_* )
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# ollama pull qwen2.5:7b && ollama pull nomic-embed-text

# OpenAI (perfil cloud o si usas provider openai)
OPENAI_API_KEY=sk-...

# ASR para módulos con vídeo (PDF usa pypdf; no requiere esto)
# WHISPER_PROVIDER=openai
# WHISPER_MODEL=whisper-1
# Infra universidad (endpoint compatible OpenAI /audio/transcriptions):
# WHISPER_PROVIDER=openai_compatible
# WHISPER_BASE_URL=http://172.28.230.10:PORT/v1
# WHISPER_MODEL=whisper-1
# WHISPER_API_KEY=local
# WHISPER_TIMEOUT_SEC=600

# Observabilidad (opcional)
# LOG_LEVEL=INFO
# LOG_VERBOSE=true

# LangSmith (opcional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=orquestacion-agentes-educacion

# SQL Agent: BD de negocio institucional consultable en lenguaje natural
# (distinta de DATABASE_URL, que es metadatos de la app). Usuario MySQL
# recomendado con permisos solo SELECT.
# AGENT_DB_URI=mysql+pymysql://USER_SOLO_LECTURA:PASSWORD@HOST:3306/DB_NEGOCIO
# MAX_SQL_AGENT_ITERACIONES=10

# MySQL + API
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=cambia-este-secreto
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# UI Streamlit (cliente HTTP de la API JWT)
# Local: http://127.0.0.1:8000
# En Docker (compose/red interna) el script de deploy fuerza http://asistente-ia-educacion:8000
STREAMLIT_API_BASE_URL=http://127.0.0.1:8000

# SSH / despliegue remoto (no subir contraseñas al repo)
# SSH_HOST=146.190.151.125
# SSH_USER=root
# SSH_PORT=22
# SSH_PASSWORD=
# DEPLOY_PATH=/opt/asistente-ia
# API_BASE_URL=http://146.190.151.125:8000
# CONTAINER_NAME=asistente-ia-educacion
# UI_CONTAINER_NAME=asistente-ia-ui
# DOCKER_IMAGE=asistente-ia_asistente:latest
# DOCKER_NETWORK=asistente-net
